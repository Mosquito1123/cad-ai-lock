# Copy to .env and fill locally. NEVER commit .env.

# Provider: mock | replicate | fal | local
CAD_AI_PROVIDER=mock

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
REPLICATE_MODEL_NAME=jagilley/controlnet-canny
# Optional: owner/name:version for /v1/predictions
# REPLICATE_CONTROLNET_MODEL=

# fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=
FAL_CONTROLNET_MODEL=fal-ai/flux/dev/image-to-image

# OpenAI-compatible vision API (optional geometry refine)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini

# Generation defaults
CONTROL_STRENGTH=0.85
GUIDANCE_SCALE=7.5
NUM_INFERENCE_STEPS=30

# Soft layout policies
POLICY_DAYLIGHT=true
POLICY_FENGSHUI=false
POLICY_COMMON_SENSE=true
STRUCTURE_THRESHOLD=0.35
POLICY_THRESHOLD=0.55
